# Exemplo de configuração local. Sem segredo real: os valores abaixo são os
# do docker-compose e não servem fora da máquina de desenvolvimento.
#
#   cp .env.example .env

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# ─── banco ───────────────────────────────────────────────────────────────────
# O serviço conecta como wallet_service, que NÃO tem UPDATE nem DELETE no
# ledger. As migrations rodam como o dono do schema (usuário wallet).
DATABASE_URL=postgres://wallet_service:dev@postgres:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=30s

# ─── mensageria ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_IN=wager-transactions.fifo
SQS_QUEUE_DLQ=wager-transactions-dlq.fifo
SQS_QUEUE_OUT=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=5
# Mapa remetente IAM -> provedor autorizado. No LocalStack todo remetente é o
# account id 000000000000, por isso o curinga local. Em produção, cada
# provedor tem seu principal IAM mapeado ao próprio providerId.
SQS_SENDER_PROVIDERS=000000000000=*

# ─── autenticação ────────────────────────────────────────────────────────────
OIDC_ISSUER_URL=http://keycloak:8080/realms/wallet
OIDC_AUDIENCE=
OIDC_INTERNAL_SCOPE=wallets:write

# ─── workers ─────────────────────────────────────────────────────────────────
OUTBOX_INTERVAL=1s
OUTBOX_BATCH=20
OUTBOX_MAX_ATTEMPTS=8

PENDING_INTERVAL=2s
PENDING_BATCH=20
PENDING_BASE_DELAY=1s
PENDING_MAX_DELAY=1m
PENDING_MAX_ATTEMPTS=6

CONFLICT_RETRIES=3
SHUTDOWN_TIMEOUT=20s
